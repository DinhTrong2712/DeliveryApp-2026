# ─── Image source (only used on VPS with docker-compose.prod.yml) ───
GHCR_OWNER=dinhtrong2712
IMAGE_TAG=latest

# ─── PostgreSQL ───
POSTGRES_DB=delivery_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_strong_password

# ─── JWT (MUST be >= 64 random chars) ───
JWT_SECRET=replace_with_openssl_rand_hex_32_or_longer
JWT_ISSUER=DeliveryApp
JWT_AUDIENCE=DeliveryApp

# ─── Public domain (Caddy issues Let's Encrypt cert for this) ───
# Must have an A record pointing to this VPS BEFORE first start.
PUBLIC_DOMAIN=delivery.example.com
ACME_EMAIL=you@example.com

# ─── Public origin (used for CORS — keep in sync with PUBLIC_DOMAIN) ───
PUBLIC_ORIGIN=https://delivery.example.com

# ─── Web port (only used for local dev without Caddy) ───
WEB_PORT=80

# ─── SePay ───
SEPAY_API_KEY=

# ─── AI provider ───
AI_PROVIDER=openrouter
AI_MODEL=deepseek/deepseek-chat-v3.1
AI_API_KEY=

# ─── Cloudflare R2 (photo storage, optional) ───
R2_BUCKET=
R2_ENDPOINT=
R2_ACCESS_KEY=
R2_SECRET_KEY=

# ─── Backup ───
BACKUP_TIME=02:00
BACKUP_RETENTION=14
